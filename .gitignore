# --- Executables ---
# Ignore everything in bin...
bin/*
# ...Except the data folder (Assets are here)
!bin/data/
# ...And except necessary dynamic libraries (if on Windows/Linux)
!bin/*.dll
!bin/*.so
!bin/*.dylib

